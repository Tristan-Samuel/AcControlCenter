# Copy to /etc/ac-control.env on the central Pi. Never commit the real file.

FLASK_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
PREFERRED_URL_SCHEME=http

# SQLite is the default (instance/ac_control.db). Override if needed:
# DATABASE_URL=sqlite:////var/lib/ac-control/ac_control.db

ALLOW_PUBLIC_REGISTRATION=false

# Home-Pi demo. Fake ESP32s heartbeat through the real policy path.
# SIMULATION_MODE=true
# SIMULATION_ADMIN_PASSWORD=
# SIMULATION_TICK_SECONDS=5

# School-wide token the ESP32 sends on /api/v1/enroll (optional).
# ENROLL_TOKEN=

# Public dashboard URL if IT reverse-proxies a subdomain. ESP32s must still
# use the Pi LAN IP — this is for browsers off campus only.
# PUBLIC_BASE_URL=https://ac.yourschool.edu
# PREFERRED_URL_SCHEME=https

# Optional mail
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# Fallback if the school cannot reverse-proxy a subdomain.
USE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
