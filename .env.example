# Copy to /etc/ac-control.env on the central Pi. Never commit the real file.

FLASK_ENV=production
SESSION_SECRET=replace-with-a-long-random-string
PORT=5000
PREFERRED_URL_SCHEME=https

# SQLite is the default (instance/ac_control.db). Override if needed:
# DATABASE_URL=sqlite:////var/lib/ac-control/ac_control.db

ALLOW_PUBLIC_REGISTRATION=false

# Optional mail
# MAIL_SERVER=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USE_TLS=true
# MAIL_USERNAME=
# MAIL_PASSWORD=
# MAIL_DEFAULT_SENDER=

# Classroom Pis on other VLANs / off-campus. Prefer a reserved ngrok domain.
USE_NGROK=false
NGROK_AUTHTOKEN=
NGROK_DOMAIN=
