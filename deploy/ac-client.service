[Unit]
Description=AC Control Center classroom client
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=acclient
WorkingDirectory=/opt/ac-client
EnvironmentFile=/etc/ac-client.env
ExecStart=/usr/bin/python3 /opt/ac-client/ac_client.py
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
