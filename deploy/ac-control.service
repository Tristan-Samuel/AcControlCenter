[Unit]
Description=AC Control Center
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=YOURUSER
Group=YOURUSER
WorkingDirectory=/home/YOURUSER/apps/ac-control
EnvironmentFile=/etc/ac-control.env
ExecStart=/home/YOURUSER/apps/ac-control/.venv/bin/gunicorn -c gunicorn.conf.py --bind 127.0.0.1:5091 wsgi:app
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
